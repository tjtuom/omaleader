{
  // Omaleader example keymap, used when ~/.config/omarchy/omaleader.jsonc
  // does not exist. Copy it there to make your own; saved changes apply at once.
  //
  // Each key is a single character (case-sensitive: "g" and "G" differ) or one
  // of: space, tab, enter, left, right, up, down.
  //
  // Fields:
  //   label     Text shown next to the key.
  //   keys      Makes the entry a group: its own nested keymap.
  //   dispatch  Hyprland Lua dispatcher, same syntax as bindings.lua, e.g.
  //             "hl.dsp.window.close()" or "o.workspaces.focus(3)".
  //   exec      Shell command (run through bash -lc).
  //   stay      true keeps the popup open after running, so the key can be
  //             repeated (handy for resizing). Esc closes.
  //
  // In the popup: Backspace goes up a level, Esc closes. Pressing the leader
  // shortcut again acts as Space at the current level (or closes the menu if
  // that level has no "space").

  "w": { "label": "Window", "keys": {
    "q": { "label": "Close", "dispatch": "hl.dsp.window.close()" },
    "f": { "label": "Fullscreen", "dispatch": "hl.dsp.window.fullscreen({ mode = \"fullscreen\" })" },
    "m": { "label": "Maximize (full width)", "dispatch": "hl.dsp.window.fullscreen({ mode = \"maximized\" })" },
    "t": { "label": "Float / tile", "dispatch": "hl.dsp.window.float({ action = \"toggle\" })" },
    "o": { "label": "Pop out (float & pin)", "exec": "omarchy-hyprland-window-pop" },
    "p": { "label": "Pseudo tile", "dispatch": "hl.dsp.window.pseudo()" },
    "n": { "label": "Minimize to dock", "exec": "omarchy-hyprland-window-minimize" },
    "h": { "label": "Swap left", "dispatch": "hl.dsp.window.swap({ direction = \"l\" })" },
    "j": { "label": "Swap down", "dispatch": "hl.dsp.window.swap({ direction = \"d\" })" },
    "k": { "label": "Swap up", "dispatch": "hl.dsp.window.swap({ direction = \"u\" })" },
    "l": { "label": "Swap right", "dispatch": "hl.dsp.window.swap({ direction = \"r\" })" },
    "r": { "label": "Resize", "keys": {
      "h": { "label": "Narrower", "dispatch": "hl.dsp.window.resize({ x = -50, y = 0, relative = true })", "stay": true },
      "l": { "label": "Wider", "dispatch": "hl.dsp.window.resize({ x = 50, y = 0, relative = true })", "stay": true },
      "k": { "label": "Shorter", "dispatch": "hl.dsp.window.resize({ x = 0, y = -50, relative = true })", "stay": true },
      "j": { "label": "Taller", "dispatch": "hl.dsp.window.resize({ x = 0, y = 50, relative = true })", "stay": true },
    }},
    "g": { "label": "Group", "keys": {
      "g": { "label": "Toggle group", "dispatch": "hl.dsp.group.toggle()" },
      "o": { "label": "Move out of group", "dispatch": "hl.dsp.window.move({ out_of_group = true })" },
      "n": { "label": "Next in group", "dispatch": "hl.dsp.group.next()", "stay": true },
      "p": { "label": "Previous in group", "dispatch": "hl.dsp.group.prev()", "stay": true },
      "h": { "label": "Into group left", "dispatch": "hl.dsp.window.move({ into_group = \"l\" })" },
      "j": { "label": "Into group below", "dispatch": "hl.dsp.window.move({ into_group = \"d\" })" },
      "k": { "label": "Into group above", "dispatch": "hl.dsp.window.move({ into_group = \"u\" })" },
      "l": { "label": "Into group right", "dispatch": "hl.dsp.window.move({ into_group = \"r\" })" },
    }},
  }},

  "s": { "label": "Workspace", "keys": {
    "1": { "label": "Move window to 1", "dispatch": "o.workspaces.move_window(1)" },
    "2": { "label": "Move window to 2", "dispatch": "o.workspaces.move_window(2)" },
    "3": { "label": "Move window to 3", "dispatch": "o.workspaces.move_window(3)" },
    "4": { "label": "Move window to 4", "dispatch": "o.workspaces.move_window(4)" },
    "5": { "label": "Move window to 5", "dispatch": "o.workspaces.move_window(5)" },
    "n": { "label": "Next workspace", "dispatch": "hl.dsp.focus({ workspace = \"m+1\" })", "stay": true },
    "p": { "label": "Previous workspace", "dispatch": "hl.dsp.focus({ workspace = \"m-1\" })", "stay": true },
    "s": { "label": "Toggle scratchpad", "dispatch": "hl.dsp.workspace.toggle_special(\"scratchpad\")" },
    "S": { "label": "Window to scratchpad", "dispatch": "hl.dsp.window.move({ workspace = \"special:scratchpad\", follow = false })" },
  }},

  "l": { "label": "Layout", "keys": {
    "s": { "label": "Toggle split", "dispatch": "hl.dsp.layout(\"togglesplit\")" },
    "c": { "label": "Cycle layout", "exec": "omarchy-hyprland-workspace-layout-toggle" },
    "C": { "label": "Cycle layout back", "exec": "omarchy-hyprland-workspace-layout-toggle back" },
  }},

  "m": { "label": "Monitor", "keys": {
    "h": { "label": "Window to left monitor", "dispatch": "o.workspaces.move_window_to_monitor(\"l\")" },
    "l": { "label": "Window to right monitor", "dispatch": "o.workspaces.move_window_to_monitor(\"r\")" },
    "H": { "label": "Workspace to left monitor", "dispatch": "o.workspaces.move_to_monitor(\"l\")" },
    "L": { "label": "Workspace to right monitor", "dispatch": "o.workspaces.move_to_monitor(\"r\")" },
    "n": { "label": "Focus next monitor", "dispatch": "hl.dsp.focus({ monitor = \"+1\" })" },
  }},

  "c": { "label": "Capture", "keys": {
    "s": { "label": "Screenshot", "exec": "omarchy capture screenshot" },
    "t": { "label": "Text (OCR)", "exec": "omarchy capture text" },
    "r": { "label": "Start/stop recording", "exec": "omarchy capture screenrecording" },
  }},

  "t": { "label": "Toggle", "keys": {
    "n": { "label": "Night light", "exec": "omarchy toggle nightlight" },
    "i": { "label": "Stay awake", "exec": "omarchy toggle idle" },
    "b": { "label": "Bar", "exec": "omarchy toggle bar" },
    "d": { "label": "Do not disturb", "exec": "omarchy toggle notification silencing" },
  }},

  "q": { "label": "System", "keys": {
    "l": { "label": "Lock", "exec": "omarchy-system-lock" },
    "s": { "label": "Suspend", "exec": "systemctl suspend" },
    "m": { "label": "System menu", "exec": "omarchy-menu toggle system" },
  }},

  "o": { "label": "Omarchy menu", "exec": "omarchy-menu toggle root" },

  // Space, or the leader shortcut pressed again: back to the previous workspace.
  "space": { "label": "Previous workspace", "dispatch": "hl.dsp.focus({ workspace = \"previous_per_monitor\" })" },
}
